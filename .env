# INVT AI Platform 环境变量配置（开发模式）
# 开发模式使用 H2 内嵌数据库，无需 MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=invt_ai_platform
DB_USERNAME=invt_ai_platform
DB_PASSWORD=dev-password-123456789
DB_ROOT_PASSWORD=dev-root-password-123456789
JWT_SECRET=dev-jwt-secret-not-for-production-use
INVT_CORS_ALLOWED_ORIGINS=http://localhost:5173
INVT_PUBLIC_BASE_URL=http://localhost:18088
MATE_WIKI_WATCHER_ENABLED=false
MATE_WIKI_WATCHER_INTERVAL_MS=300000
